{
  "preservePrefix": "speaker.",
  "parameters": [
    {
      "key": "speak.model",
      "label": "Model",
      "type": "dropdown",
      "required": true,
      "default": "lightning_v3.1",
      "data": "text-to-speech-models.json",
      "valueField": "model_id",
      "errorMessage": "Please select a valid model for text to speech."
    },
    {
      "key": "speak.voice.id",
      "label": "Voice",
      "type": "dropdown",
      "required": true,
      "default": "magnus",
      "data": "text-to-speech-voices.json",
      "valueField": "voice_id",
      "searchable": true,
      "strict": false,
      "customValue": true,
      "errorMessage": "Please select a valid voice for text to speech."
    },
    {
      "key": "speak.language",
      "label": "Language",
      "type": "dropdown",
      "required": false,
      "default": "en",
      "data": "languages.json",
      "valueField": "language_id",
      "errorMessage": "Please select a valid language for text to speech."
    },
    {
      "key": "speak.speed",
      "label": "Speed",
      "type": "number",
      "required": false,
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "placeholder": "1.0 (default)"
    }
  ]
}
